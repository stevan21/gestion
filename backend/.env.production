# ============================================
# Configuration de production — Flux Gestion
# Ne versionnez jamais le fichier .env réel.
# ============================================

# Django
DEBUG=False
SECRET_KEY=change-moi-par-une-cle-aleatoire-de-50-caracteres
ALLOWED_HOSTS=votre-domaine.com,www.votre-domaine.com

# Base de données PostgreSQL
DB_ENGINE=django.db.backends.postgresql
DB_NAME=fluxgestion_db
DB_USER=postgres
DB_PASSWORD=mot-de-passe-securise
DB_HOST=db
DB_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=https://votre-domaine.com,https://www.votre-domaine.com

# Cache et file de tâches
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=alertes@votre-domaine.com
EMAIL_HOST_PASSWORD=mot-de-passe-application
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=alertes@votre-domaine.com
ALERT_NOTIFICATION_EMAIL=ops@votre-domaine.com

# Sécurité (appliquée automatiquement dès que DEBUG=False)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000

# Seuils d'alerte
ALERT_THRESHOLD_CRITICAL=150
ALERT_THRESHOLD_HIGH=125
ALERT_THRESHOLD_MEDIUM=110

# Journalisation
DJANGO_LOG_LEVEL=WARNING
API_LOG_LEVEL=INFO

# Localisation
LANGUAGE_CODE=fr-fr
TIME_ZONE=Europe/Paris
