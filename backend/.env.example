# ============================================
# Configuration de développement — Flux Gestion
# Copiez ce fichier en .env et adaptez les valeurs.
# ============================================

# Django
DEBUG=True
SECRET_KEY=django-insecure-dev-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Base de données (SQLite par défaut en développement)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
# Pour PostgreSQL :
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=fluxgestion_db
# DB_USER=postgres
# DB_PASSWORD=password
# DB_HOST=localhost
# DB_PORT=5432

# CORS : origines autorisées à appeler l'API depuis le navigateur
CORS_ALLOWED_ORIGINS=http://localhost:8001,http://127.0.0.1:8001,http://localhost:3000

# Cache et file de tâches
# Sans REDIS_URL, le cache est en mémoire et les tâches Celery s'exécutent
# en local (mode eager) : aucun worker n'est nécessaire.
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_TASK_ALWAYS_EAGER=False

# Email (console en développement)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=votre-email@example.com
# EMAIL_HOST_PASSWORD=votre-mot-de-passe-application
# EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@fluxgestion.local
# Destinataire des notifications d'alerte critique
# ALERT_NOTIFICATION_EMAIL=ops@example.com

# Seuils d'alerte, exprimés en pourcentage de la valeur cible
ALERT_THRESHOLD_CRITICAL=150
ALERT_THRESHOLD_HIGH=125
ALERT_THRESHOLD_MEDIUM=110

# Journalisation
DJANGO_LOG_LEVEL=INFO
API_LOG_LEVEL=INFO

# Localisation
LANGUAGE_CODE=fr-fr
TIME_ZONE=Europe/Paris
